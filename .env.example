# Environment Configuration for Department-Based Plant Identification Portal

# MongoDB Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/text_to_plant?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/text_to_plant
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/text_to_plant?retryWrites=true&w=majority
# Alternatively, you can use MONGODB_URI or DATABASE_URL:
# MONGODB_URI=mongodb+srv://...
# DATABASE_URL=mongodb+srv://...
# If left blank, automatically falls back to local SQLite (text_to_plant.db)

# Flask Session Security Secret Key
SESSION_SECRET=plant_botanical_secure_session_secret_key_2026_xyz

# Default Administrator Credentials
